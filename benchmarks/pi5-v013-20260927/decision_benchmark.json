    {
      "id": "access-01",
      "domain": "access",
      "request": {
        "state": {
          "role": "reader",
          "enabled": true,
          "failed_attempts": 0
        },
        "decisions": [
          {
            "id": "role_scope",
            "instruction": "Map role to its scope using the options. For this question only, ignore enabled and failed_attempts.",
            "kind": {
              "type": "choice",
              "options": [
                {
                  "id": "read",
                  "criterion": "The role is reader."
                },
                {
                  "id": "edit",
                  "criterion": "The role is editor."
                },
                {
                  "id": "administer",
                  "criterion": "The role is admin."
                }
              ]
            }
          },
          {
            "id": "can_edit",
            "instruction": "Editing is allowed if enabled is true AND role is editor or admin. Otherwise editing is not allowed.",
            "kind": {
              "type": "binary",
              "false_label": "Editing is not allowed.",
              "true_label": "Editing is allowed."
            }
          },
          {
            "id": "review_priority",
            "instruction": "Choose review priority using only failed_attempts and the exact thresholds in the levels.",
            "kind": {
              "type": "ordinal",
              "levels": [
                {
                  "id": "low",
                  "criterion": "Zero failed attempts.",
                  "value": 0
                },
                {
                  "id": "medium",
                  "criterion": "One or two failed attempts.",
                  "value": 1
                },
                {
                  "id": "high",
                  "criterion": "Three or more failed attempts.",
                  "value": 2
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "role_scope": "read",
        "can_edit": "false",
        "review_priority": "low"
      }
    },
